<Window x:Class="Soccer_Project___Abi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Soccer_Project___Abi"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid x:Name="Trivia_Main_Page" Height="550" Background="White">
        <TextBlock x:Name="TitleText" HorizontalAlignment="Left" Margin="213,26,0,0" TextWrapping="Wrap" Text="Real Madrid Trivia" VerticalAlignment="Top" FontSize="36" FontFamily="Arial Black"/>
        <Image x:Name="MadridLogo" HorizontalAlignment="Left" Height="273" Margin="292,65,0,0" VerticalAlignment="Top" Width="207" Source="/Real-Madrid-CF-logo-512x711.png" RenderTransformOrigin="2.462,0.701"/>
        <Button x:Name="StartButton" Content="Start Trivia" HorizontalAlignment="Left" Margin="292,351,0,0" VerticalAlignment="Top" Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}" Height="60" Width="197" FontSize="36" FontFamily="Bahnschrift Condensed" BorderBrush="Black" Foreground="White" Click="OpenSecondWindow_Click"/>

    </Grid>
</Window>
